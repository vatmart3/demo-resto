{
  "name": "vernet-elec-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site vitrine de démonstration pour artisans — MJAGENCY",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host",
    "metier": "node scripts/use-preset.mjs",
    "photos:unsplash": "node scripts/fetch-unsplash.mjs",
    "photos:render": "node scripts/render-placeholders.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
